digraph G {
 graph [fontname="DejaVu Sans", fontsize=20, labelloc=t, pad=0.4,
  label=<<B>4. Fragilidades do controle de esterçamento e situação atual</B><BR/><FONT POINT-SIZE="12">branch pendente-teste/ajustes-pre-merge · verde = corrigido · amarelo = parcial/observar · vermelho = aberto</FONT><BR/> >];
 node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
 t [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#bbbbbb"><TR><TD BGCOLOR="#2a6fb0"><FONT COLOR="white"><B>#</B></FONT></TD><TD BGCOLOR="#2a6fb0"><FONT COLOR="white"><B>Risco</B></FONT></TD><TD BGCOLOR="#2a6fb0"><FONT COLOR="white"><B>Fragilidade</B></FONT></TD><TD BGCOLOR="#2a6fb0"><FONT COLOR="white"><B>O que acontecia</B></FONT></TD><TD BGCOLOR="#2a6fb0"><FONT COLOR="white"><B>Sugestão</B></FONT></TD><TD BGCOLOR="#2a6fb0"><FONT COLOR="white"><B>Situação</B></FONT></TD></TR><TR><TD BGCOLOR="#f8dcd8">1</TD><TD BGCOLOR="#f8dcd8"><B>ALTA</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>Windup com o atuador<BR ALIGN="LEFT"/>desconectado<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">O controlador roda mesmo sem permissão de movimento;<BR ALIGN="LEFT"/>com o motor parado, a integral acumulava até saturar<BR ALIGN="LEFT"/>e o esterçamento partia com até 100% ao habilitar.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Zerar a integral sem<BR ALIGN="LEFT"/>permissão.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#d9f2e3">CORRIGIDO (47b6108): update() recebe a<BR ALIGN="LEFT"/>permissão; sem ela a integral fica em zero.<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#f8dcd8">2</TD><TD BGCOLOR="#f8dcd8"><B>ALTA</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>LVDT desconectado ou em<BR ALIGN="LEFT"/>curto não detectado<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">valid só conferia 0 ≤ ADC ≤ 4095. ADC = 0 lê −28,9°<BR ALIGN="LEFT"/>e parece leitura real; o motor iria ao batente sem<BR ALIGN="LEFT"/>detecção.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Validar faixa do ADC e<BR ALIGN="LEFT"/>sinal travado.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#fff6d6">MITIGADO (c826ce2): mediana de 3, ADC<BR ALIGN="LEFT"/>travado ±3 por 500 ms e fora de [40, 4055]<BR ALIGN="LEFT"/>por 10 ms invalidam. Entrada flutuante ainda<BR ALIGN="LEFT"/>não é detectada (plausibilidade, TODO).<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fbe5d3">3</TD><TD BGCOLOR="#fbe5d3"><B>MÉDIA</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>Zona morta sem histerese<BR ALIGN="LEFT"/>+ piso de 0,15<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">Na borda de ±1,5° o comando saltava de 0 para 0,15.<BR ALIGN="LEFT"/>Visto no teste de 12/10: PWM alternando 0/38 a cada<BR ALIGN="LEFT"/>100–300 ms.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Histerese na zona morta.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#d9f2e3">CORRIGIDO (6cd69e8): entra com |e| ≤ 0,4°,<BR ALIGN="LEFT"/>sai com |e| &gt; 1,2°.<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fbe5d3">4</TD><TD BGCOLOR="#fbe5d3"><B>MÉDIA</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>Zona morta grande para o<BR ALIGN="LEFT"/>Stanley<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">Erro estacionário de até ±1,5° (curvatura ~0,023<BR ALIGN="LEFT"/>1/m).<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Reduzir junto com a<BR ALIGN="LEFT"/>histerese.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#fff6d6">REDUZIDO: erro máximo 1,2°, típico ~0,4°.<BR ALIGN="LEFT"/>Validar em teste.<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fbe5d3">5</TD><TD BGCOLOR="#fbe5d3"><B>MÉDIA</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>Integral zerada dentro<BR ALIGN="LEFT"/>da zona morta<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">Ao entrar na zona morta o esforço de sustentação é<BR ALIGN="LEFT"/>descartado; se o mecanismo voltar sozinho, entra e<BR ALIGN="LEFT"/>sai ciclicamente.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Manter a integral se o<BR ALIGN="LEFT"/>redutor for reversível.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#fff6d6">EM OBSERVAÇÃO: redutor com atrito, volta<BR ALIGN="LEFT"/>pouco. Observar em teste antes de mudar.<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fbe5d3">6</TD><TD BGCOLOR="#fbe5d3"><B>MÉDIA</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>Fim de curso com limites<BR ALIGN="LEFT"/>não validados<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">Limites de ±30° nunca atingidos; o lado direito<BR ALIGN="LEFT"/>chega ao fim físico em ~28,9°.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Limites abaixo do fim<BR ALIGN="LEFT"/>físico.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#d9f2e3">CORRIGIDO (ce4614a, f37fc87): trabalho ±20°,<BR ALIGN="LEFT"/>segurança ±25°, fundo de escala do LVDT<BR ALIGN="LEFT"/>~28,5°.<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fff6d6">7</TD><TD BGCOLOR="#fff6d6"><B>BAIXA</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>Integral pode sozinha<BR ALIGN="LEFT"/>comandar 100%<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">Limite de ±10 °·s × Ki 0,1 = ±1,0 (a escala<BR ALIGN="LEFT"/>inteira).<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Limitar a parcela integral<BR ALIGN="LEFT"/>(ex.: ±0,5).<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#f8dcd8">ABERTO (efeito reduzido com a correção do<BR ALIGN="LEFT"/>windup).<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fff6d6">8</TD><TD BGCOLOR="#fff6d6"><B>BAIXA</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>Kp baixo: malha dominada<BR ALIGN="LEFT"/>por I + piso<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">P só passa do piso de 0,15 com erro acima de ~21°;<BR ALIGN="LEFT"/>na prática é relé ±0,15 + integral.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Subir Kp e rever o piso em<BR ALIGN="LEFT"/>ensaio.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#f8dcd8">ABERTO (sintonia).<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#fff6d6">9</TD><TD BGCOLOR="#fff6d6"><B>BAIXA</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>Referência sem limite de<BR ALIGN="LEFT"/>taxa<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">angular_velocity_deg_s é recebido e ignorado;<BR ALIGN="LEFT"/>degraus viram velocidade máxima do motor.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Rate limiter usando esse<BR ALIGN="LEFT"/>campo.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#f8dcd8">ABERTO.<BR ALIGN="LEFT"/></TD></TR><TR><TD BGCOLOR="#eeeeee">10</TD><TD BGCOLOR="#eeeeee"><B>LATENTE</B></TD><TD ALIGN="LEFT" BALIGN="LEFT"><B>Derivada sobre o erro,<BR ALIGN="LEFT"/>sem filtro<BR ALIGN="LEFT"/></B></TD><TD ALIGN="LEFT" BALIGN="LEFT">Hoje Kd = 0. Se ativada, degraus de referência geram<BR ALIGN="LEFT"/>pico e ruído amplificado.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT">Derivar a medição<BR ALIGN="LEFT"/>filtrada.<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#f8dcd8">ABERTO (inativo com Kd = 0).<BR ALIGN="LEFT"/></TD></TR>
 <TR><TD COLSPAN="6" ALIGN="LEFT" BGCOLOR="#d9f2e3">Pontos fortes: entradas NaN/velhas resetam e invalidam a saída · dt fora de (0, 100 ms] reseta · anti-windup condicional na saturação · integral zerada sem permissão · fim de curso bloqueia<BR ALIGN="LEFT"/>só o sentido que piora e zera a integral · saída monitorada pelo SafetyManager (≤ 20 ms) · inversão do motor com tempo morto.<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}